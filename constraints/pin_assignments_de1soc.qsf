#set_location_assignment PIN_AG8  -to DRAM_ADDR[2]
#set_location_assignment PIN_AF8  -to DRAM_ADDR[3]
#set_location_assignment PIN_AH7  -to DRAM_ADDR[4]
#set_location_assignment PIN_AG6  -to DRAM_ADDR[5]
#set_location_assignment PIN_AF6  -to DRAM_ADDR[6]
#set_location_assignment PIN_AH8  -to DRAM_ADDR[7]
#set_location_assignment PIN_AF9  -to DRAM_ADDR[8]
#set_location_assignment PIN_AD10 -to DRAM_ADDR[9]
#set_location_assignment PIN_AD11 -to DRAM_ADDR[10]
#set_location_assignment PIN_AG10 -to DRAM_ADDR[11]
#set_location_assignment PIN_AF10 -to DRAM_ADDR[12]

# SDRAM Bank Address
#set_location_assignment PIN_AG7  -to DRAM_BA[0]
#set_location_assignment PIN_AH10 -to DRAM_BA[1]

# SDRAM Data
#set_location_assignment PIN_Y11  -to DRAM_DQ[0]
#set_location_assignment PIN_AA10 -to DRAM_DQ[1]
#set_location_assignment PIN_AB9  -to DRAM_DQ[2]
#set_location_assignment PIN_AA9  -to DRAM_DQ[3]
#set_location_assignment PIN_AB8  -to DRAM_DQ[4]
#set_location_assignment PIN_AA8  -to DRAM_DQ[5]
#set_location_assignment PIN_AB7  -to DRAM_DQ[6]
#set_location_assignment PIN_AA7  -to DRAM_DQ[7]
#set_location_assignment PIN_AC12 -to DRAM_DQ[8]
#set_location_assignment PIN_AC11 -to DRAM_DQ[9]
#set_location_assignment PIN_AB12 -to DRAM_DQ[10]
#set_location_assignment PIN_AB11 -to DRAM_DQ[11]
#set_location_assignment PIN_AA12 -to DRAM_DQ[12]
#set_location_assignment PIN_AA11 -to DRAM_DQ[13]
#set_location_assignment PIN_Y12  -to DRAM_DQ[14]
#set_location_assignment PIN_Y10  -to DRAM_DQ[15]

# SDRAM Control Signals
#set_location_assignment PIN_AF11 -to DRAM_CAS_N
#set_location_assignment PIN_AE13 -to DRAM_CKE
#set_location_assignment PIN_AH12 -to DRAM_CS_N
#set_location_assignment PIN_AE12 -to DRAM_LDQM
#set_location_assignment PIN_AH9  -to DRAM_RAS_N
#set_location_assignment PIN_AG12 -to DRAM_UDQM
#set_location_assignment PIN_AF13 -to DRAM_WE_N

# ============================================================================
# Configuración Global del Dispositivo
# ============================================================================
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY dsa_system_wrapper
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

# ============================================================================
# Configuración de Compilación
# ============================================================================
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

# ============================================================================
# Timing Constraints
# ============================================================================
# Clock de 50 MHz = 20 ns de periodo
create_clock -name {CLOCK_50} -period 20.000 -waveform { 0.000 10.000 } [get_ports {CLOCK_50}]

# Derivar clocks automáticamente del PLL
derive_pll_clocks
derive_clock_uncertainty

# ============================================================================
# Fin del archivo
# ============================================================================
