	component dsa_system is
		port (
			clk_clk                             : in  std_logic                    := 'X'; -- clk
			pio_leds_external_connection_export : out std_logic_vector(9 downto 0);        -- export
			reset_reset                         : in  std_logic                    := 'X'  -- reset
		);
	end component dsa_system;

