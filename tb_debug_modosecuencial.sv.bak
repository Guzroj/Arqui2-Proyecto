`timescale 1ns/1ps

module tb_debug_modosecuencial();
    // Señales
    logic              clk;
    logic              rst;
    logic              valid_in;
    logic [7:0]        I00, I10, I01, I11;
    logic [7:0]        alpha, beta;
    logic              valid_out;
    logic [7:0]        pixel_out;
    
    // Instancia del DUT
    ModoSecuencial dut (.*);
    
    // Reloj
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end
    
    // Prueba simple que está fallando
    initial begin
        $display("\n=== TEST DE DIAGNÓSTICO ===\n");
        
        // Reset
        rst = 1;
        valid_in = 0;
        I00 = 0; I10 = 0; I01 = 0; I11 = 0;
        alpha = 0; beta = 0;
        repeat(3) @(posedge clk);
        rst = 0;
        @(posedge clk);
        
        // Test que falla: Gradiente horizontal
        $display("Test: Gradiente horizontal (0→255)");
        $display("Inputs: I00=0, I10=255, I01=0, I11=255");
        $display("Coeffs: alpha=128 (0.5), beta=128 (0.5)");
        $display("Esperado: ~128\n");
        
        @(posedge clk);
        valid_in = 1'b1;
        I00 = 8'd0;
        I10 = 8'd255;
        I01 = 8'd0;
        I11 = 8'd255;
        alpha = 8'd128;  // 0.5
        beta = 8'd128;   // 0.5
        
        @(posedge clk);
        valid_in = 1'b0;
        
        // Esperar salida
        @(posedge clk);
        @(posedge clk);
        
        $display("=== RESULTADOS ===");
        $display("pixel_out = %0d", pixel_out);
        $display("valid_out = %0b", valid_out);
        
        // Verificar señales internas (debes descomentar si puedes acceder)
        $display("\n=== SEÑALES INTERNAS (si están disponibles) ===");
        // $display("I00_q = %0d (0x%04h)", $signed(dut.I00_q), dut.I00_q);
        // $display("I10_q = %0d (0x%04h)", $signed(dut.I10_q), dut.I10_q);
        // $display("a_q   = %0d (0x%04h)", $signed(dut.a_q), dut.a_q);
        // $display("b_q   = %0d (0x%04h)", $signed(dut.b_q), dut.b_q);
        // $display("v_q   = %0d (0x%04h)", $signed(dut.v_q), dut.v_q);
        
        // Cálculo manual esperado
        $display("\n=== CÁLCULO MANUAL ===");
        logic signed [15:0] I00_q, I10_q, alpha_q;
        logic signed [31:0] mult_ax;
        logic signed [15:0] term_ax, a_q;
        
        I00_q = {8'd0, 8'b0};     // 0 en Q8.8
        I10_q = {8'd255, 8'b0};   // 65280 en Q8.8
        alpha_q = {8'b0, 8'd128}; // 128 en Q8.8
        
        $display("I00_q   = %0d (decimal) = 0x%04h", $signed(I00_q), I00_q);
        $display("I10_q   = %0d (decimal) = 0x%04h", $signed(I10_q), I10_q);
        $display("alpha_q = %0d (decimal) = 0x%04h", alpha_q);
        
        mult_ax = (I10_q - I00_q) * alpha_q;
        $display("mult_ax = %0d (decimal) = 0x%08h", $signed(mult_ax), mult_ax);
        
        term_ax = mult_ax[23:8];
        $display("term_ax = %0d (decimal) = 0x%04h", $signed(term_ax), term_ax);
        
        a_q = I00_q + term_ax;
        $display("a_q     = %0d (decimal) = 0x%04h", $signed(a_q), a_q);
        $display("a_q en float = %.2f", real'($signed(a_q))/256.0);
        
        // Como I01=0 y I11=255 igual que arriba, b_q debería ser igual a a_q
        // Entonces v = a + beta*(b-a) = a + 0.5*0 = a ≈ 127.5
        
        repeat(5) @(posedge clk);
        
        $display("\n=== TEST 2: Imagen blanca ===");
        @(posedge clk);
        valid_in = 1'b1;
        I00 = 255;
        I10 = 255;
        I01 = 255;
        I11 = 255;
        alpha = 128;
        beta = 128;
        
        @(posedge clk);
        valid_in = 1'b0;
        
        repeat(3) @(posedge clk);
        $display("pixel_out = %0d (esperado: 255)", pixel_out);
        
        repeat(2) @(posedge clk);
        $finish;
    end
    
    // Dump
    initial begin
        $dumpfile("debug.vcd");
        $dumpvars(0, tb_debug_modosecuencial);
    end
    
endmodule